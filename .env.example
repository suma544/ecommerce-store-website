# PostgreSQL (Neon / Supabase / Heroku Postgres) or MySQL (mysql+pymysql://...)
DATABASE_URL=postgresql://user:password@host:5432/store
# Optional: signs login tokens (derived from DATABASE_URL if not set)
SECRET_KEY=change-me-to-a-long-random-string
# Optional: create an admin on start (otherwise the first registered account is admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
