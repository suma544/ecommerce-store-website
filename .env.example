# PostgreSQL (Neon / Supabase / Heroku Postgres) or MySQL (mysql+pymysql://...)
DATABASE_URL=postgresql://user:password@host:5432/store
# Used to sign login tokens - set a long random value in production
SECRET_KEY=change-me-to-a-long-random-string
# First admin account (created automatically on start)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=change-me
